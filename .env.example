# Server-only Django REST API base URL for BFF route handlers (no trailing slash)
API_BASE_URL=http://127.0.0.1:8000

# Active brand identifier: "anbessa" | "demo"
NEXT_PUBLIC_BRAND=anbessa

# Secret key used for signing and verifying httpOnly BFF session cookies
SESSION_SECRET=change-this-to-a-secure-random-secret-key-at-least-32-chars
