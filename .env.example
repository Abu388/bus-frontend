# Server-only Django REST API base URL for BFF route handlers (no trailing slash)
API_BASE_URL=http://127.0.0.1:8000

# Active brand identifier: "anbessa" | "demo"
NEXT_PUBLIC_BRAND=anbessa

# Map and Geo Service Configuration (OSM services deployed host)
NEXT_PUBLIC_MAP_BASE_URL=https://186.241.23.111.nip.io
NEXT_PUBLIC_TILE_URL=https://186.241.23.111.nip.io/tile/{z}/{x}/{y}.png
NEXT_PUBLIC_GEOCODE_URL=https://186.241.23.111.nip.io
NEXT_PUBLIC_ROUTE_URL=https://186.241.23.111.nip.io

# Optional Map Viewport Overrides (defaults to brand center/zoom e.g. Addis Ababa: 9.0155, 38.7636, zoom 13)
NEXT_PUBLIC_MAP_CENTER_LAT=9.0155
NEXT_PUBLIC_MAP_CENTER_LNG=38.7636
NEXT_PUBLIC_MAP_ZOOM=13
